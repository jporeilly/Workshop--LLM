# Ollama configuration (optional, if you want to use a non-default URL)
OLLAMA_BASE_URL=http://localhost:11434

# If you want to fall back to OpenAI in some cases
# OPENAI_API_KEY=your_openai_api_key

# For DuckDuckGo tools, no API key is typically needed

# For YFinance tools, no API key is typically needed

# If you want to fall back to Cloud Agno in some cases
# AGNO_API_KEY="YOUR_AGNO_API_KEY"
AGNO_MONITOR=true

# If you want to customize the SQLite storage location
# AGNO_STORAGE_PATH=custom/path/to/storage.db