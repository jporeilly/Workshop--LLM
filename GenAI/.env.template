# Environment Variables for AI Stack
# Copy this file to .env and fill in your values

# PostgreSQL Configuration
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=password
POSTGRES_DB=ai_workflows

# n8n Configuration
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here
# N8N_USER_MANAGEMENT_JWT_SECRET=your_jwt_secret_here  # Only needed if you want user management

# Flowise Configuration
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=password
FLOWISE_SECRET_KEY=secretkey

# Open-WebUI Configuration
WEBUI_AUTH=false
# WEBUI_SECRET_KEY=your_webui_secret_key_here  # Only needed if WEBUI_AUTH=true

# GPU Configuration for Multiple GPUs
# Uncomment and configure based on your GPU setup

# Option 1: Use all GPUs (default)
NVIDIA_VISIBLE_DEVICES=all

# Option 2: Use specific GPUs by ID (0,1,2,etc.)
# NVIDIA_VISIBLE_DEVICES=0,1,2

# Option 3: Use specific GPU for specific services
# FLOWISE_GPU_DEVICE=0
# OPEN_WEBUI_GPU_DEVICE=1
# N8N_GPU_DEVICE=2
# QDRANT_GPU_DEVICE=0

# CUDA driver capabilities
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Optional: Set memory limits per service
# FLOWISE_MEMORY_LIMIT=4G
# OPEN_WEBUI_MEMORY_LIMIT=2G
# N8N_MEMORY_LIMIT=2G
# QDRANT_MEMORY_LIMIT=2G
# POSTGRES_MEMORY_LIMIT=1G

# GPU Memory Management (for Ollama on host)
# OLLAMA_GPU_MEMORY_FRACTION=0.8
# OLLAMA_NUM_GPU=2